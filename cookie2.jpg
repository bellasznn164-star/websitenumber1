/* NerdPress edits to remove border in recipe card sections PC July 12th 2026 */

.wprm-recipe-equipment-container,
.wprm-recipe-ingredients-container {
  border-style: none !important;
}

/*Mediavine Mobile 6/7/8 CSS */

@media only screen and (max-width: 499px) {

 .wprm-recipe

   .baran-header

   .baran-header-columns

   .right-column

   .wprm-recipe-block-container:not(.wprm-recipe-author-container) {

   position: unset !important;

 }

}

.wp-block-gallery.has-nested-images figure.wp-block-image:has(figcaption):before {
	backdrop-filter: none!important;
	mask-image: none!important;
}

/* Increase body text size for better ad spacing */
.entry-content p {
    font-size: 19px;
    line-height: 1.6;
}

/* Mediavine Mobile CSS */

@media only screen and (max-width: 460px) {
.wprm-recipe .baran-main .main-recipe-body .nutrition, .wprm-recipe .baran-main .main-recipe-body .notes {
    max-width: 100% !important;
    transform: none !important;
}
.wprm-recipe .baran-main .main-recipe-body .nutrition {
    padding-left: unset !important;
    padding-right: unset !important;
}
.wprm-nutrition-label-text-nutrition-container {
    max-width: 100% !important
}
}

/* Mediavine Sidebar CSS */

@media only screen and (min-width: 993px) {
.post-body .grid {
    grid-template-columns: 1fr 370px !important;
    column-gap: clamp(1rem, 3vw, 3rem);
}
}

/*End CSS*/.wp-block-search__inside-wrapper {background: transparent}
:root :where(.wp-block-cover){padding-top: 80px;padding-right: 15px;padding-bottom: 80px;padding-left: 15px;}
:root :where(.wp-block-navigation){font-family: var(--wp--preset--font-family--archivo);font-size: 14px;font-weight: 600;letter-spacing: 1.96px;line-height: 1;text-transform: uppercase;}:root :where(.wp-block-navigation-is-layout-flow) > :first-child{margin-block-start: 0;}:root :where(.wp-block-navigation-is-layout-flow) > :last-child{margin-block-end: 0;}:root :where(.wp-block-navigation-is-layout-flow) > *{margin-block-start: 76px;margin-block-end: 0;}:root :where(.wp-block-navigation-is-layout-constrained) > :first-child{margin-block-start: 0;}:root :where(.wp-block-navigation-is-layout-constrained) > :last-child{margin-block-end: 0;}:root :where(.wp-block-navigation-is-layout-constrained) > *{margin-block-start: 76px;margin-block-end: 0;}:root :where(.wp-block-navigation-is-layout-flex){gap: 76px;}:root :where(.wp-block-navigation-is-layout-grid){gap: 76px;}
/*# sourceURL=global-styles-inline-css */
