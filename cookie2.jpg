list-style-type: none;"><span class="wprm-checkbox-container"><input type="checkbox" id="wprm-checkbox-2" class="wprm-checkbox" aria-label="Rubber Spatula"><label for="wprm-checkbox-2" class="wprm-checkbox-label"><span class="sr-only screen-reader-text wprm-screen-reader-text" data-nosnippet>&#x25a2; </span></label></span><div class="wprm-recipe-equipment-name"><a href="https://link.amazon/B08hL2ET5" class="wprm-recipe-equipment-link">Rubber Spatula</a></div></li><li class="wprm-recipe-equipment-item" style="list-style-type: none;"><span class="wprm-checkbox-container"><input type="checkbox" id="wprm-checkbox-3" class="wprm-checkbox" aria-label="Cookie Scooper"><label for="wprm-checkbox-3" class="wprm-checkbox-label"><span class="sr-only screen-reader-text wprm-screen-reader-text" data-nosnippet>&#x25a2; </span></label></span><div class="wprm-recipe-equipment-name"><a href="https://www.amazon.com/gp/product/B091NKW39H/ref=as_li_tl?ie=UTF8&#038;tag=baranbakery1-20&#038;camp=1789&#038;creative=9325&#038;linkCode=as2&#038;creativeASIN=B091NKW39H&#038;linkId=56dcb0bc78f5c6853bb8c92fe586291d" class="wprm-recipe-equipment-link">Cookie Scooper</a></div></li><li class="wprm-recipe-equipment-item" style="list-style-type: none;"><span class="wprm-checkbox-container"><input type="checkbox" id="wprm-checkbox-4" class="wprm-checkbox" aria-label="Sea Salt "><label for="wprm-checkbox-4" class="wprm-checkbox-label"><span class="sr-only screen-reader-text wprm-screen-reader-text" data-nosnippet>&#x25a2; </span></label></span><div class="wprm-recipe-equipment-name"><a href="https://www.amazon.com/gp/product/B00017028M/ref=as_li_tl?ie=UTF8&#038;tag=baranbakery1-20&#038;camp=1789&#038;creative=9325&#038;linkCode=as2&#038;creativeASIN=B00017028M&#038;linkId=aef3566e06a4c0607b784947900f3406" class="wprm-recipe-equipment-link">Sea Salt </a></div></li><li class="wprm-recipe-equipment-item" style="list-style-type: none;"><span class="wprm-checkbox-container"><input type="checkbox" id="wprm-checkbox-5" class="wprm-checkbox" aria-label="Parchment Sheets"><label for="wprm-checkbox-5" class="wprm-checkbox-label"><span class="sr-only screen-reader-text wprm-screen-reader-text" data-nosnippet>&#x25a2; </span></label></span><div class="wprm-recipe-equipment-name"><a href="https://www.amazon.com/gp/product/B07P1YJFF7/ref=as_li_tl?ie=UTF8&#038;tag=baranbakery1-20&#038;camp=1789&#038;creative=9325&#038;linkCode=as2&#038;creativeASIN=B07P1YJFF7&#038;linkId=83c5faaf7cbbedfbaca0f24d192742dd" class="wprm-recipe-equipment-link">Parchment Sheets</a></div></li><li class="wprm-recipe-equipment-item" style="list-style-type: none;"><span class="wprm-checkbox-container"><input type="checkbox" id="wprm-checkbox-6" class="wprm-checkbox" aria-label="Whisk"><label for="wprm-checkbox-6" class="wprm-checkbox-label"><span class="sr-only screen-reader-text wprm-screen-reader-text" data-nosnippet>&#x25a2; </span></label></span><div class="wprm-recipe-equipment-name"><a href="https://link.amazon/B0eI2K5wI" class="wprm-recipe-equipment-link">Whisk</a></div></li></ul></div>
        </div>
